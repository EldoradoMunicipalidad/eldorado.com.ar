# Base de datos del backend. No uses una URL con credenciales en el código fuente.
DATABASE_URL=postgresql://usuario:contraseña@host/base?sslmode=require

# Firebase Admin: usar una variable segura o credenciales ADC del entorno.
FIREBASE_PROJECT_ID=municipalidad-632de
FIREBASE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=

# Backend: clave privada de MiniMax. Nunca usar el prefijo VITE_ porque
# Vite incluiría esa variable en el bundle público del navegador.
MINIMAX_API_KEY=pegá acá tu clave de MiniMax

# Opcional. Por defecto usa el modelo recomendado por MiniMax.
MINIMAX_MODEL=MiniMax-M2.7
